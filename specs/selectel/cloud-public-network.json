{"provider":"selectel","product":"cloud-public-network","operations_list":[{"tool":"cloud_public_network_projects_quotas_list","method":"get","path":"/v1/projects/{project_id}/quotas","summary":"Get project quotas","kind":"read","auth":"iam_project","params":[{"name":"project_id","in":"path","required":true,"schema":{"type":"string","pattern":"^[a-f0-9]{32}$","example":"df6f01408bef4878a2f32307684aa6f9"},"description":"Project identifier in compact UUID format (no hyphens)."}]},{"tool":"cloud_public_network_public_ports_list","method":"get","path":"/v1/public_ports","summary":"List public ports","kind":"read","auth":"iam_project","params":[{"name":"network_id","in":"query","schema":{"type":"string","format":"uuid"},"description":"Filters ports by network identifier."},{"name":"description","in":"query","schema":{"type":"string"},"description":"Filters ports by description."},{"name":"subnet","in":"query","schema":{"type":"string"},"description":"Filters ports by network subnet CIDR."}]},{"tool":"cloud_public_network_public_ports_create","method":"post","path":"/v1/public_ports","summary":"Create public port","kind":"write","auth":"iam_project","params":[],"body":{"title":"PortCreateRequest","type":"object","properties":{"description":{"type":"string","nullable":true,"maxLength":5000,"description":"Public port description."},"admin_state_up":{"type":"boolean","default":true,"description":"Indicates whether the port administrative state is up."},"security_group_ids":{"type":"array","items":{"type":"string","format":"uuid"},"maxItems":20,"description":"List of security group identifiers to associate with the port. If not provided, the default security group is assigned."}}}},{"tool":"cloud_public_network_public_ports_get","method":"get","path":"/v1/public_ports/{port_id}","summary":"Get public port","kind":"read","auth":"iam_project","params":[{"name":"port_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"},"description":"Public port identifier. This ID is the same as the corresponding OpenStack port ID."}]},{"tool":"cloud_public_network_public_ports_patch","method":"patch","path":"/v1/public_ports/{port_id}","summary":"Update public port","kind":"write","auth":"iam_project","params":[{"name":"port_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"},"description":"Public port identifier. This ID is the same as the corresponding OpenStack port ID."}],"body":{"title":"PortUpdateRequest","type":"object","properties":{"description":{"type":"string","nullable":true,"maxLength":5000,"description":"Public port description."},"admin_state_up":{"type":"boolean","description":"Indicates whether the port administrative state is up."},"security_group_ids":{"type":"array","items":{"type":"string","format":"uuid"},"minItems":1,"maxItems":20,"description":"List of security group identifiers to associate with the port."}}}},{"tool":"cloud_public_network_public_ports_delete","method":"delete","path":"/v1/public_ports/{port_id}","summary":"Delete public port","kind":"destructive","auth":"iam_project","params":[{"name":"port_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"},"description":"Public port identifier. This ID is the same as the corresponding OpenStack port ID."}]}]}
