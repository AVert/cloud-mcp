# Учётные данные провайдеров (один файл на всех, chmod 600)
CLOUD_ACCOUNTS_FILE=
# Подмножество провайдеров через запятую (пусто = все)
CLOUD_PROVIDERS=
# Кэш каталогов
CLOUD_CACHE_DIR=
# Гейты безопасности: 1/0
CLOUD_READONLY=0
CLOUD_ALLOW_DESTRUCTIVE=0
# Таймаут HTTP, сек
CLOUD_TIMEOUT=60
# Свой каталог снапшотов (по умолчанию пакетные specs/)
CLOUD_SPECS_DIR=
# Регион selectel (ru-2 | ru-3 | ru-8 | kz-1 | uz-1...), дефолт ru-2
SELECTEL_REGION=
# Точечный оверрайд базового URL продукта (если регион не подходит)
SELECTEL_BASE_MANAGED_DATABASES=
# Совместимость с timeweb-mcp (если cloud-файла учёток нет)
TIMEWEB_TOKEN=
TIMEWEB_ACCOUNTS_FILE=

# Совместимость со старым sweb-mcp (SWEB_* читаются, если в файле нет entry "sweb")
SWEB_TOKEN=
SWEB_ACCOUNTS_FILE=
SWEB_ACCOUNT=
SWEB_LOGIN=
SWEB_PASSWORD=
SWEB_MIN_INTERVAL=0.2
SWEB_MAX_CONCURRENCY=4
